{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "NODE_ENV=production node dist/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "ts-node -r tsconfig-paths/register src/db/seed.ts",
    "db:seed:bulk": "ts-node -r tsconfig-paths/register src/db/seed-bulk.ts",
    "db:import": "ts-node -r tsconfig-paths/register src/db/import-photos.ts",
    "db:backfill": "ts-node -r tsconfig-paths/register src/db/backfill-media.ts",
    "alert:test": "ts-node -r tsconfig-paths/register src/alerts/alert-test.ts",
    "openapi:export": "ts-node -r tsconfig-paths/register src/openapi-export.ts",
    "bench": "ts-node bench/bench.ts",
    "test": "jest --runInBand",
    "user:create": "ts-node -r tsconfig-paths/register src/db/create-user.ts",
    "watchdog": "ts-node src/alerts/watchdog.ts"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.4.1",
    "cache-manager": "^7.2.0",
    "cacheable": "^2.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.6",
    "exif-reader": "2.0.2",
    "express": "^5.1.0",
    "file-type": "^16.5.4",
    "helmet": "^8.1.0",
    "keyv": "^6.1.0",
    "multer": "^2.0.2",
    "p-limit": "^3.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.8",
    "@nestjs/testing": "^11.1.6",
    "@types/autocannon": "^7.12.7",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.7.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "autocannon": "^8.0.0",
    "drizzle-kit": "^0.31.5",
    "jest": "^30.2.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "test/.*\\.e2e-spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "testTimeout": 30000
  }
}
