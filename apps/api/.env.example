NODE_ENV=development
PORT=3000
BIND_HOST=0.0.0.0
DATABASE_URL=./data/app.db
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
WEB_ORIGIN=http://localhost:5173
ALLOW_DEMO_SEED=false
# Express "trust proxy" setting (e.g. 2 behind Cloudflare + nginx). Empty = off.
TRUST_PROXY=
# Built web app to serve from the API process (optional, e.g. ../web/dist)
WEB_DIST_DIR=

# Telegram alerts (leave empty to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated event groups: system,auth,admin,engagement,error (default: all)
ALERT_EVENTS=system,auth,admin,engagement,error
# Prefix shown on every alert, e.g. the environment name
ALERT_LABEL=dev
THROTTLE_LIMIT=120

# Absolute public site URL (share links, og:image). Empty = derived from the request.
PUBLIC_URL=
