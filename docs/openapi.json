    "/api/v1/admin/photos": {
      "get": {
        "description": "All photos including soft-deleted ones, newest first, cursor-paginated. Filter with `status`.",
        "operationId": "AdminPhotosController_list",
        "parameters": [
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Page size. Clamped to 1-60.",
            "schema": {
              "minimum": 1,
              "maximum": 60,
              "default": 24,
              "example": 24,
              "type": "number"
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "Opaque cursor from the previous page's `nextCursor`. Omit for the first page.",
            "schema": {
              "example": "eyJrIjoicCIsImlkIjoxMDB9",
              "type": "string"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "default": "all",
              "type": "string",
              "enum": [
                "active",
                "deleted",
                "all"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PhotoListDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "403": {
            "description": "Not an admin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List photos (admin)",
        "tags": [
          "Admin"
        ]
      },
      "post": {
        "description": "Upload 1 to 20 images (JPEG, PNG or WebP, max 15 MB each) as multipart field `files`. Types are checked by magic bytes. If any file is invalid the whole request fails and nothing is kept.",
        "operationId": "AdminPhotosController_upload",
        "parameters": [],
