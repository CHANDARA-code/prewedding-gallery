    "/api/v1/photos": {
      "get": {
        "description": "Active photos, newest first, cursor-paginated. Public; send a bearer token to also get `isFavorite` and `isSaved` flags. Guest responses are cacheable for 30 s.",
        "operationId": "PhotosController_list",
        "parameters": [
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Page size. Clamped to 1-60.",
            "schema": {
              "minimum": 1,
              "maximum": 60,
              "default": 24,
              "example": 24,
              "type": "number"
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "Opaque cursor from the previous page's `nextCursor`. Omit for the first page.",
            "schema": {
              "example": "eyJrIjoicCIsImlkIjoxMDB9",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PhotoListDto"
                }
              }
            }
          },
          "400": {
            "description": "Malformed cursor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List photos",
        "tags": [
          "Photos"
        ]
      }
    },
