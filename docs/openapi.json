  "info": {
    "title": "Pre-Wedding View API",
    "description": "Public pre-wedding photo gallery with per-user favorites and saves, and admin photo management.",
    "version": "1.1",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "https://prewedding.leavchandara.com",
      "description": "Production"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local development"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "demo"
          },
          "password": {
            "type": "string",
            "example": "password"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "username": {
            "type": "string",
            "example": "demo"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "admin"
            ],
            "example": "user"
          }
        },
        "required": [
          "id",
          "username",
          "role"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "tokenType": {
            "type": "string",
            "example": "Bearer"
          },
          "expiresIn": {
            "type": "number",
            "example": 3600,
            "description": "Token lifetime in seconds"
          },
          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        },
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn",
          "user"
        ]
      },
      "ErrorDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 404
          },
          "error": {
            "type": "string",
            "example": "Not Found"
          },
          "message": {
            "type": "string",
            "example": "Photo not found"
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      },
      "PhotoDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 12
          },
          "title": {
            "type": "string",
            "example": "Golden hour",
            "nullable": true
          },
          "caption": {
            "type": "string",
            "example": "Angkor Wat, sunrise",
            "nullable": true
          },
          "url": {
            "type": "string",
            "example": "/uploads/8f2c1a.jpg"
          },
          "thumbUrl": {
            "type": "string",
            "example": "/uploads/thumbs/8f2c1a.webp"
          },
          "width": {
            "type": "number",
            "example": 3000
          },
          "height": {
            "type": "number",
            "example": 2000
          },
          "createdAt": {
            "type": "string",
            "example": "2026-11-01T08:30:00.000Z"
          },
          "isFavorite": {
            "type": "boolean",
            "example": false,
            "description": "Present only when a valid token was sent."
          },
          "isSaved": {
            "type": "boolean",
            "example": true,
            "description": "Present only when a valid token was sent."
          },
          "deletedAt": {
            "type": "string",
            "example": null,
            "nullable": true,
            "description": "Only ever non-null on admin responses."
          },
          "mimeType": {
            "type": "string",
            "example": "image/jpeg",
            "description": "Admin detail only."
          },
          "sizeBytes": {
            "type": "number",
            "example": 2119246,
            "description": "Admin detail only."
          },
          "uploadedBy": {
            "type": "number",
            "example": 2,
            "description": "Admin detail only."
          }
        },
        "required": [
          "id",
          "title",
          "caption",
          "url",
          "thumbUrl",
          "width",
          "height",
          "createdAt",
          "deletedAt"
        ]
      },
      "PhotoListDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PhotoDto"
            }
          },
          "nextCursor": {
            "type": "string",
            "example": "eyJrIjoicCIsImlkIjoxMDB9",
            "nullable": true
          },
          "hasMore": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "items",
          "nextCursor",
          "hasMore"
        ]
      },
      "UploadPhotosBodyDoc": {
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "binary"
            },
            "description": "1 to 20 JPEG, PNG or WebP files, max 15 MB each"
          },
          "title": {
            "type": "string",
            "example": "Golden hour",
            "description": "Applied to every uploaded photo"
          },
          "caption": {
            "type": "string",
            "example": "Angkor Wat, sunrise",
            "description": "Applied to every uploaded photo"
          }
        },
        "required": [
          "files"
        ]
      },
      "UpdatePhotoDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Golden hour",
            "nullable": true
          },
          "caption": {
            "type": "string",
            "example": "Angkor Wat, sunrise",
            "nullable": true
          }
        }
      }
    }
  }
}
